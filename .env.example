DATABASE_URL=postgresql://user:password@localhost:5432/beijerink
JWT_SECRET=change-me-to-a-random-64-char-hex-string
ADMIN_PASSWORD=change-me

# Cloudflare R2 (for image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=beijer-ink-images
R2_PUBLIC_URL=

# Google Calendar read-only overlay (OAuth user flow)
# From Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Redirect URI must match the one registered there (per environment).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# autofingers.com publishing
# AUTOFINGERS_EXPORT_TOKEN: shared secret the static-site build sends to read the
#   publish feed (GET /api/publish/autofingers). Make it long + random.
# CLOUDFLARE_DEPLOY_HOOK_URL: the "Publish now" button POSTs here to rebuild the
#   site immediately. Create it in Cloudflare → the autofingers project → Deploy hooks.
AUTOFINGERS_EXPORT_TOKEN=
CLOUDFLARE_DEPLOY_HOOK_URL=

# Daily SFTP backups
BACKUP_ENABLED=false
BACKUP_CRON=0 2 * * *
BACKUP_TIMEZONE=Europe/London
BACKUP_SFTP_HOST=
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USERNAME=
BACKUP_SFTP_PASSWORD=
BACKUP_SFTP_REMOTE_DIR=/beijer-ink-backups

PORT=3000
NODE_ENV=development
